<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Authorization code · Angler</title>
    <style>
      body { font-family: system-ui, sans-serif; max-width: 32rem; margin: 4rem auto; padding: 0 1rem; }
      .code { font-family: ui-monospace, monospace; font-size: 1.125rem; padding: 0.75rem 1rem; background: #f4f4f4; border-radius: 0.5rem; word-break: break-all; }
    </style>
  </head>
  <body>
    <h1>Authorization code</h1>
    <p>Copy this code into the application:</p>
    <p class="code">{@code}</p>
  </body>
</html>
